# ==============================================================================
# OneMarket - Environment Configuration Template (.env.example)
# Copy this file to .env and configure with your credentials:
#   cp .env.example .env
# ==============================================================================

# 1. Express Application Port
PORT=3000

# 2. Supabase Postgres Configuration (@supabase/supabase-js)
# Required for live Supabase cloud database connectivity
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-public-key-here

# 3. Payment Gateway Configuration (Indian UPI & Cards)
# Provider options: razorpay (default test sandbox)
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_MODE=sandbox
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# 4. JWT Authentication Secret
JWT_SECRET=onemarket-super-secret-jwt-key-change-in-production

# 5. Optional Legacy MySQL Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=localloop
DB_CONNECTION_LIMIT=10

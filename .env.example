# LocalLoop Environment Configuration Template
# Copy this file to .env and replace the values with your local MySQL setup:
#   cp .env.example .env

# Web Server Port
PORT=3000

# MySQL Database Connection Details
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=localloop

# Optional: Connection Pool Limit
DB_CONNECTION_LIMIT=10
